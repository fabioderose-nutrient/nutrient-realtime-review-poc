# Nutrient license keys. Leave empty to run in evaluation mode.
# Document Engine activation key or offline license key.
ACTIVATION_KEY=
# Web SDK license key, used by the viewer in the browser.
WEB_SDK_LICENSE_KEY=

# Local-only passwords for PostgreSQL and the Document Engine dashboard
# (http://localhost:5310/dashboard, user "dashboard"). Change them.
POSTGRES_PASSWORD=change-me
DASHBOARD_PASSWORD=change-me

# Ports on the host. The browser talks to both.
APP_PORT=4310
DOCUMENT_ENGINE_PORT=5310
